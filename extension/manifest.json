{
  "manifest_version": 3,
  "name": "Bingqilin Popup Blocker",
  "version": "2.0.0",
  "description": "Blocks the popups and tab-unders that the Bingqilin player's video embeds open, and lets Live TV show TVNZ's own player. Acts on the player only — never on the tools pages or anywhere else.",
  "minimum_chrome_version": "111",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": { "service_worker": "background.js", "type": "module" },

  "permissions": ["webNavigation", "storage", "scripting", "declarativeNetRequest"],

  "host_permissions": ["<all_urls>"],

  "declarative_net_request": {
    "rule_resources": [
      { "id": "tvnz_frame", "enabled": true, "path": "rules/tvnz-frame.json" },
      { "id": "sandbox", "enabled": true, "path": "rules/sandbox.json" }
    ]
  },

  "action": { "default_title": "Bingqilin Popup Blocker" },

  "content_scripts": [
    {
      "matches": ["https://thebingchilling.pages.dev/*"],
      "exclude_matches": ["https://thebingchilling.pages.dev/tools/*"],
      "js": ["content/keepalive.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*/*"],
      "exclude_matches": ["https://thebingchilling.pages.dev/*", "https://*.tvnz.co.nz/*"],
      "js": ["content/no-popup.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://thebingchilling.pages.dev/live", "https://thebingchilling.pages.dev/live.html"],
      "js": ["content/tvnz-frame.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.tvnz.co.nz/*"],
      "js": ["content/tvnz-in-frame.js"],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
