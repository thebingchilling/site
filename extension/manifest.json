{
  "manifest_version": 3,
  "name": "Bingqilin Popup Blocker",
  "version": "1.6.1",
  "description": "Closes the popups and tab-unders that the Bingqilin player's video embeds open, and lets Live TV play the TVNZ channels. Runs on the player only — never on the tools pages or anywhere else.",
  "minimum_chrome_version": "102",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": { "service_worker": "background.js", "type": "module" },

  "permissions": ["webNavigation", "storage", "scripting", "declarativeNetRequest"],

  "host_permissions": [
    "https://thebingchilling.github.io/*",
    "https://i.mjh.nz/*",
    "https://c.mjh.nz/*",
    "https://*.tvnz.co.nz/*",
    "https://*.switch.tv/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      { "id": "live_cors", "enabled": true, "path": "rules/live-cors.json" }
    ]
  },

  "optional_host_permissions": ["*://*/*"],

  "action": { "default_title": "Bingqilin Popup Blocker" },

  "content_scripts": [
    {
      "matches": ["https://thebingchilling.github.io/*"],
      "exclude_matches": ["https://thebingchilling.github.io/tools/*"],
      "js": ["content/keepalive.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://thebingchilling.github.io/live", "https://thebingchilling.github.io/live.html"],
      "js": ["content/live-cors.js"],
      "run_at": "document_start"
    }
  ]
}
